#!/usr/bin/env bash

format=%d
separator=$'\n'
terminator=
usage_text="Usage: $0 [-f format] [-s string] [-t string] [-w] [first [incr]] last"
while getopts 0123456789f:s:t:w opt; do
    case $opt in
        f) format="$OPTARG";;
        s) separator="$OPTARG";;
        t) terminator="$OPTARG";;
        w) pad=1;;
        [0-9]) break;;
        ?) echo $usage_text>&2
           exit 1;;
    esac
    shift $[OPTIND - 1]
    OPTIND=1
done
[[ $# == 0 ]] || [[ $# -gt 3 ]] && echo $usage_text>&2 && exit 1
[[ $2 ]] && first=$1 || first=1
last=${*: -1}
if [[ $3 ]]; then
    increment=$2
else
    [[ $first -lt $last ]] && increment=1 || increment=-1
fi
[[ $increment -lt 0 ]] && comparison=\>= || comparison=\<=
last=${*: -1}
if [[ $pad ]]; then
    first_length=${#first}
    last_length=${#last}
    if [[ $first_length -gt $last_length ]]; then
        format=%0${first_length}d
    else
        format=%0${last_length}d
    fi
fi
for ((i=first;i${comparison}last;i+=increment)); {
    printf "$format" $i
    echo -n "$separator"
}
echo -n "$terminator"
